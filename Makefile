# **************************************************************************** #
#                                   SETTINGS                                   #
# **************************************************************************** #

NAME    := cub3D

CC      := gcc
CFLAGS  := -Wall -Wextra -Werror -g
RM      := rm -f

OBJ_DIR := objects
INC_DIR := .

MLX_DIR := minilibx
MLX     := $(MLX_DIR)/libmlx.a

UNAME_S := $(shell uname)

ifeq ($(UNAME_S),Linux)
	MLX_FLAGS = -lXext -lX11 -lm -lbsd
else
	MLX_FLAGS = -framework OpenGL -framework AppKit
endif

# **************************************************************************** #
#                                    SOURCES                                    #
# **************************************************************************** #

SRCS := $(wildcard *.c)
OBJS := $(SRCS:%.c=$(OBJ_DIR)/%.o)

# **************************************************************************** #
#                                     RULES                                     #
# **************************************************************************** #

all: $(NAME)

$(NAME): $(OBJS) $(MLX)
	$(CC) $(CFLAGS) $(OBJS) $(MLX) $(MLX_FLAGS) -o $(NAME)

# **************************************************************************** #
#                                  OBJECT FILES                                 #
# **************************************************************************** #

$(OBJ_DIR)/%.o: %.c
	@mkdir -p $(OBJ_DIR)
	$(CC) $(CFLAGS) -I$(INC_DIR) -I$(MLX_DIR) -c $< -o $@

# **************************************************************************** #
#                                   MLX RULE                                    #
# **************************************************************************** #

$(MLX):
	$(MAKE) -C $(MLX_DIR)

# **************************************************************************** #
#                                   CLEAN RULES                                 #
# **************************************************************************** #

clean:
	$(RM) $(OBJS)
	$(RM) -r $(OBJ_DIR)
	$(MAKE) clean -C $(MLX_DIR)

fclean: clean
	$(RM) $(NAME)

re: fclean all

.PHONY: all clean fclean re
