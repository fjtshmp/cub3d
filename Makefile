# **************************************************************************** #
#                                    NAME                                      #
# **************************************************************************** #

NAME        := cub3D

# **************************************************************************** #
#                                   COMPILER                                   #
# **************************************************************************** #

CC          := cc
CFLAGS      := -Wall -Wextra -Werror
# CFLAGS += -fsanitize=address
DEBUG       := -g
RM          := rm -f

# **************************************************************************** #
#                                   DIRECTORIES                                #
# **************************************************************************** #

INCLUDE_DIR := include
LIBFT_DIR   := libft
GNL_DIR     := gnl
MLX_DIR     := minilibx
OBJ_DIR     := obj

SRC_PARSE_DIR := src_parse
SRC_EXEC_DIR  := src_exec

# **************************************************************************** #
#                                   FILES                                      #
# **************************************************************************** #

SRC_PARSE := $(wildcard $(SRC_PARSE_DIR)/*.c)
SRC_EXEC  := $(wildcard $(SRC_EXEC_DIR)/*.c)
SRC_GNL   := $(wildcard $(GNL_DIR)/*.c)

SRC       := $(SRC_PARSE) $(SRC_EXEC) $(SRC_GNL)

OBJ       := $(SRC:%.c=$(OBJ_DIR)/%.o)

# **************************************************************************** #
#                                   LIBRARIES                                  #
# **************************************************************************** #

LIBFT     := $(LIBFT_DIR)/libft.a
MLX       := $(MLX_DIR)/libmlx.a

LIBS      := -L$(LIBFT_DIR) -lft \
             -L$(MLX_DIR) -lmlx \
             -lXext -lX11 -lm

# **************************************************************************** #
#                                   INCLUDES                                   #
# **************************************************************************** #

INCLUDES  := -I$(INCLUDE_DIR) \
             -I$(LIBFT_DIR) \
             -I$(GNL_DIR) \
             -I$(MLX_DIR)

# **************************************************************************** #
#                                   RULES                                      #
# **************************************************************************** #

all: $(NAME)

$(NAME): $(LIBFT) $(MLX) $(OBJ)
	$(CC) $(CFLAGS) $(OBJ) $(LIBS) -o $(NAME)

# **************************************************************************** #
#                                   OBJECTS                                    #
# **************************************************************************** #

$(OBJ_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# **************************************************************************** #
#                                   LIBFT                                      #
# **************************************************************************** #

$(LIBFT):
	$(MAKE) -C $(LIBFT_DIR)

# **************************************************************************** #
#                                   MLX                                        #
# **************************************************************************** #

$(MLX):
	$(MAKE) -C $(MLX_DIR)

# **************************************************************************** #
#                                   CLEAN                                      #
# **************************************************************************** #

clean:
	$(RM) -r $(OBJ_DIR)
	$(MAKE) -C $(LIBFT_DIR) clean
	$(MAKE) -C $(MLX_DIR) clean

fclean: clean
	$(RM) $(NAME)
	$(MAKE) -C $(LIBFT_DIR) fclean

re: fclean all

.PHONY: all clean fclean re
